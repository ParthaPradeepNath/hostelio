# Database (Neon)
# DATABASE_URL is the pooled connection used at runtime.
# DIRECT_URL is the direct (unpooled) connection used for migrations.
DATABASE_URL="postgresql://user:password@host-pooler.region.aws.neon.tech/hostelio?sslmode=require"
DIRECT_URL="postgresql://user:password@host.region.aws.neon.tech/hostelio?sslmode=require"

# JWT auth
# Use a random string of at least 32 characters. Required in production.
JWT_SECRET="replace-with-a-random-string-at-least-32-characters-long"
# Optional. When set, creating an ADMIN account requires this code at sign-up.
ADMIN_SIGNUP_CODE=""

# AI (at least one provider key required for AI features)
AI_PROVIDER="gemini"
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.0-flash"
GROQ_API_KEY=""
GROQ_MODEL="openai/gpt-oss-120b"
AI_TIMEOUT_MS="8000"
AI_MAX_RETRIES="1"

# Optional seed overrides (defaults shown)
SEED_ADMIN_EMAIL="admin@hostelio.local"
SEED_ADMIN_PASSWORD="Admin123!"
SEED_STUDENT_EMAIL="student@hostelio.local"
SEED_STUDENT_PASSWORD="Student123!"
