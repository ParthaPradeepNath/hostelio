# Database (Neon)
# DATABASE_URL is the pooled connection used at runtime.
# DIRECT_URL is the direct (unpooled) connection used for migrations.
DATABASE_URL="postgresql://user:password@host-pooler.region.aws.neon.tech/hostelio?sslmode=require"
DIRECT_URL="postgresql://user:password@host.region.aws.neon.tech/hostelio?sslmode=require"

# Clerk
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_..."
CLERK_SECRET_KEY="sk_test_..."
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/login"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/sign-up"
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL="/dashboard"
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL="/dashboard"

# AI (at least one provider key required for AI features)
AI_PROVIDER="gemini"
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.0-flash"
GROQ_API_KEY=""
GROQ_MODEL="openai/gpt-oss-120b"
AI_TIMEOUT_MS="8000"
AI_MAX_RETRIES="1"

# Optional seed helpers
SEED_ADMIN_CLERK_ID=""
SEED_STUDENT_CLERK_ID=""
